# Load these through your shell or a secret manager. The app does not read .env automatically.
FREELANCER_OAUTH_TOKEN=
FREELANCER_ENVIRONMENT=production
FREELANCER_DRY_RUN=true
FREELANCER_ENABLE_AUTO_BIDDING=false
FREELANCER_AUTO_BID_PERMISSION_VERIFIED=false
# Non-secret reference to your verified application permission/approval; empty by default.
FREELANCER_PERMISSION_REFERENCE=
