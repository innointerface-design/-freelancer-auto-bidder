# Load these through your shell or a secret manager. The app does not read .env automatically.
FREELANCER_OAUTH_TOKEN=
FREELANCER_ENVIRONMENT=production
FREELANCER_DRY_RUN=true
FREELANCER_ENABLE_AUTO_BIDDING=false
FREELANCER_AUTO_BID_PERMISSION_VERIFIED=false
# Non-secret reference to your verified application permission/approval; empty by default.
FREELANCER_PERMISSION_REFERENCE=

# Optional web dashboard: generate the hash with `freelancer-web hash-password`.
# Supply the literal hash through your secret manager; protect $ in shell assignments.
FREELANCER_ADMIN_USERNAME=admin
FREELANCER_ADMIN_PASSWORD_HASH=
FREELANCER_WEB_DATABASE=data/web.sqlite3
FREELANCER_WEB_COOKIE_SECURE=true
FREELANCER_WEB_ALLOWED_HOSTS=localhost,127.0.0.1
FREELANCER_WEB_DEMO_MODE=false
FREELANCER_WEB_START_MONITOR=true
FREELANCER_CONFIG_FILE=config/example.toml
# Set the exact HTTPS origin when deployed, e.g. https://bidder.example.com
FREELANCER_WEB_ORIGIN=
# Optional AI provider. Without a key, proposal generation uses labelled templates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
