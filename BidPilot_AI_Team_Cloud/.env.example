# Copy only if not using setup_local.py. Never use placeholders in production.
APP_ENV=development
DATABASE_URL=sqlite:///./bidpilot_local.db
# Generate SESSION_SECRET with secrets.token_urlsafe(48).
SESSION_SECRET=
# Generate FERNET_KEY with cryptography.fernet.Fernet.generate_key().
FERNET_KEY=
ADMIN_EMAIL=owner@example.com
# Set a unique 12–256 character administrator password.
ADMIN_PASSWORD=
# setup_local.py uses ADMIN_PASSWORD_B64 instead, to preserve all password characters.
# Base64 is encoding, NOT encryption; protect this value just like the password.
SECOND_FOUNDER_EMAIL=
SECOND_FOUNDER_PASSWORD=
# Optional generated equivalents: ADMIN_PASSWORD_B64 and SECOND_FOUNDER_PASSWORD_B64.
PUBLIC_URL=http://127.0.0.1:8000
SECURE_COOKIES=false
# For production: APP_ENV=production, PUBLIC_URL=https://your-domain, SECURE_COOKIES=true
SITE_DOMAIN=
# Compose overrides DATABASE_URL to its private PostgreSQL instance.
# Generate a URL-safe password; setup_local.py supplies one.
POSTGRES_PASSWORD=
# Enable only after sandbox testing and Freelancer's express written permission for automation.
# User Agreement section 33 / API Terms section 4.9; app pacing is not a no-ban guarantee.
PLATFORM_AUTOBID_APPROVED=false
ALLOW_PRODUCTION_CONNECTION=true
SCAN_SECONDS=60
# Shared server AI credentials are used only if a user has no personal key.
# Use credentials issued by the actual provider; do not infer validity from key prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional real manual payment destinations. Blank means unavailable.
PAYMENT_JAZZCASH=
PAYMENT_EASYPAISA=
PAYMENT_BANK=
PAYMENT_STRIPE_URL=
PAYMENT_WHATSAPP=
