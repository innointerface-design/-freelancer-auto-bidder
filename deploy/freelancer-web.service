[Unit]
Description=Freelancer Auto Bidder FastAPI dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=freelancer-bidder
Group=freelancer-bidder
WorkingDirectory=/opt/freelancer-auto-bidder
EnvironmentFile=/etc/freelancer-web.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/freelancer-auto-bidder/.venv/bin/freelancer-web serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=300
RestartPreventExitStatus=2
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/freelancer-auto-bidder/data
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
