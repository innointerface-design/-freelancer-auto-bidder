FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    FREELANCER_WEB_COOKIE_SECURE=true \
    FREELANCER_WEB_DATABASE=/app/data/web.sqlite3 \
    FREELANCER_CONFIG_FILE=/app/config/example.toml

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY config/example.toml ./config/example.toml
RUN python -m pip install '.[web]' \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin bidder \
    && chmod -R a+rX /app \
    && mkdir -p /app/data \
    && chmod 700 /app/data \
    && chown -R bidder:bidder /app/data

USER bidder
VOLUME ["/app/data"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import os, urllib.request; host=os.environ.get('FREELANCER_WEB_ALLOWED_HOSTS', 'localhost').split(',')[0].strip(); request=urllib.request.Request('http://127.0.0.1:8000/healthz', headers={'Host':host}); urllib.request.urlopen(request, timeout=3).read()"

CMD ["freelancer-web", "serve", "--host", "0.0.0.0", "--port", "8000"]
