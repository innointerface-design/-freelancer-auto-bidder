[Unit]
Description=Freelancer.com project recommendations and configurable bidder
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=freelancer-bidder
Group=freelancer-bidder
WorkingDirectory=/opt/freelancer-auto-bidder
EnvironmentFile=/etc/freelancer-bidder.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/freelancer-auto-bidder/.venv/bin/freelancer-bidder --config /etc/freelancer-bidder.toml run
Restart=on-failure
RestartSec=300
RestartPreventExitStatus=2 3 4 6
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/freelancer-auto-bidder/data
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
